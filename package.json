{
  "name": "espi-ai",
  "version": "3.0.0",
  "description": "ESPI Vehicle Report API — TypeScript, multi-replica BullMQ workers, Gemini/OpenAI-compatible LLM layer, Firestore comparables with Redis cache",
  "type": "module",
  "module": "src/index.ts",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "worker": "bun run src/worker/main.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "test": "bun test test/",
    "test:golden": "bun run test/golden-set.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.11.0",
    "@google/genai": "^1.46.0",
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.1",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@types/bun": "^1.1.40",
    "typescript": "^5.7.2"
  }
}
