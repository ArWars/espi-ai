# ── Servidor HTTP ─────────────────────────────────────────────
PORT=8080
# Token para endpoints (vacío = sin auth en dev; SIEMPRE setear en prod)
API_TOKEN=

# ── LLM ───────────────────────────────────────────────────────
# Router: gemini | openai-compat | auto
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Proveedor OpenAI-compatible (OpenAI, OpenRouter, Groq, vLLM, Ollama, ...)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_CHAT_MODEL=gpt-4o-mini

# ── GCP / Firestore ───────────────────────────────────────────
GCP_PROJECT_ID=espi-ia-491115
GCP_LOCATION=us-central1
FIRESTORE_COLLECTION=chileautos_vehiculos
# En Cloud Run: ADC via metadata server. Local: ruta al JSON key.
GOOGLE_APPLICATION_CREDENTIALS=

# ── Redis (BullMQ + cache comparables) ────────────────────────
# MISMA instancia Redis que splecCore, DB DISTINTA (splecCore usa db 2)
REDIS_HOST=10.1.0.4
REDIS_PORT=6379
REDIS_PASSWORD=
ESPI_REDIS_DB=3
# Prefijo de keys de espi-ai en esa DB (evita colisiones con otros sistemas)
ESPI_REDIS_PREFIX=espi

# ── Workers / concurrencia ────────────────────────────────────
# Jobs simultáneos POR worker (cada réplica Cloud Run puede correr N)
WORKER_CONCURRENCY=4
# Cada worker toma hasta N réplicas-reintentos antes de fallar el job
WORKER_MAX_RETRIES=2

# ── Firestore comparables ─────────────────────────────────────
MARKET_CACHE_TTL_SECONDS=21600
